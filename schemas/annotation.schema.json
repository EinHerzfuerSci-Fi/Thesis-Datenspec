{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 2,
  "description": "Time-stamped note, optionally tied to a device, a run or a session.",
  "if": {
    "properties": {
      "dev": {
        "type": "null"
      }
    }
  },
  "properties": {
    "v": {
      "description": "Version of the schema. Increased only on breaking changes.",
      "maximum": 2,
      "minimum": 2,
      "title": "V",
      "type": "integer",
      "x-since": 1
    },
    "k": {
      "const": "annotation",
      "title": "K",
      "type": "string",
      "x-since": 2
    },
    "id": {
      "description": "Annotation ID, generated by the CLI; lets the pipeline drop duplicates from QoS 1.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string",
      "x-since": 2
    },
    "ts": {
      "description": "Time the note refers to, Unix seconds UTC.",
      "minimum": 0.0,
      "title": "Ts",
      "type": "number",
      "x-since": 2,
      "x-unit": "s"
    },
    "text": {
      "description": "Note text.",
      "title": "Text",
      "type": "string",
      "x-since": 2
    },
    "dev": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Device the note refers to; null if none.",
      "title": "Dev",
      "x-since": 2
    },
    "run": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Run of dev the note refers to; requires dev. null if none.",
      "title": "Run",
      "x-since": 2
    },
    "session": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Session the note refers to; null if none.",
      "title": "Session",
      "x-since": 2
    }
  },
  "required": [
    "v",
    "k",
    "id",
    "ts",
    "text",
    "dev",
    "run",
    "session"
  ],
  "then": {
    "properties": {
      "run": {
        "type": "null"
      }
    }
  },
  "title": "AnnotationMessage",
  "type": "object"
}
