{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 3,
  "$defs": {
    "InfoDs18b20": {
      "description": "DS18B20 configuration.",
      "properties": {
        "resolution_bits": {
          "description": "Configured conversion resolution.",
          "maximum": 12,
          "minimum": 9,
          "title": "Resolution Bits",
          "type": "integer",
          "x-since": 1
        },
        "rom": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ROM ID of the device's only DS18B20; also the key in data m.ds18b20. null if none was found.",
          "title": "Rom",
          "x-since": 2
        }
      },
      "required": [
        "resolution_bits",
        "rom"
      ],
      "title": "InfoDs18b20",
      "type": "object"
    },
    "InfoPio": {
      "description": "PIO program that drives the LEDs in sync with the TCS3448.",
      "properties": {
        "hz": {
          "description": "PIO state machine clock.",
          "exclusiveMinimum": 0,
          "title": "Hz",
          "type": "integer",
          "x-since": 1,
          "x-unit": "Hz"
        },
        "prog": {
          "description": "PIO program version.",
          "title": "Prog",
          "type": "string",
          "x-since": 1
        }
      },
      "required": [
        "hz",
        "prog"
      ],
      "title": "InfoPio",
      "type": "object"
    },
    "InfoProfiles": {
      "description": "Measurement profiles on the device. Their settings are not repeated here: they can\nchange per run, so each run's start record carries them as cfg.",
      "properties": {
        "names": {
          "description": "Profiles a start command can name, without duplicates.",
          "items": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "title": "Names",
          "type": "array",
          "x-since": 2
        },
        "default": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Profile used when the start command names none, or the run is started on the device; one of names.",
          "x-since": 2,
          "title": "Default"
        }
      },
      "required": [
        "names",
        "default"
      ],
      "title": "InfoProfiles",
      "type": "object"
    },
    "InfoPwm": {
      "description": "PWM dimming of the LEDs.",
      "properties": {
        "hz": {
          "description": "LED dimming PWM frequency.",
          "exclusiveMinimum": 0,
          "title": "Hz",
          "type": "integer",
          "x-since": 1,
          "x-unit": "Hz"
        },
        "sync": {
          "description": "Whether integration and PWM are phase-locked.",
          "title": "Sync",
          "type": "boolean",
          "x-since": 1
        }
      },
      "required": [
        "hz",
        "sync"
      ],
      "title": "InfoPwm",
      "type": "object"
    },
    "InfoSd": {
      "description": "SD card size at boot.",
      "properties": {
        "total": {
          "description": "Card capacity.",
          "minimum": 0,
          "title": "Total",
          "type": "integer",
          "x-since": 1,
          "x-unit": "B"
        },
        "free": {
          "description": "Free space.",
          "minimum": 0,
          "title": "Free",
          "type": "integer",
          "x-since": 1,
          "x-unit": "B"
        }
      },
      "required": [
        "total",
        "free"
      ],
      "title": "InfoSd",
      "type": "object"
    },
    "InfoSys": {
      "description": "Device identity.",
      "properties": {
        "device_name": {
          "description": "Configurable device name used for better readability",
          "title": "Device Name",
          "type": "string",
          "x-since": 1
        },
        "reset_cause": {
          "description": "Cause of the last reset.",
          "title": "Reset Cause",
          "type": "string",
          "x-since": 1
        }
      },
      "required": [
        "device_name",
        "reset_cause"
      ],
      "title": "InfoSys",
      "type": "object"
    },
    "InfoTcs3448": {
      "description": "TCS3448 configuration.",
      "properties": {
        "smux_mode": {
          "description": "SMUX mode of the TCS3448.",
          "title": "Smux Mode",
          "type": "integer",
          "x-since": 1
        },
        "agc": {
          "description": "Whether the active run regulates the TCS3448 gain, i.e. its cfg.capture.gain_control.mode is not fixed; false outside a run.",
          "title": "Agc",
          "type": "boolean",
          "x-since": 1
        }
      },
      "required": [
        "smux_mode",
        "agc"
      ],
      "title": "InfoTcs3448",
      "type": "object"
    },
    "LedInfo": {
      "description": "One illumination LED.",
      "properties": {
        "id": {
          "description": "LED ID; also the key in data led.",
          "enum": [
            "nir",
            "blue",
            "vis"
          ],
          "title": "Id",
          "type": "string",
          "x-since": 1
        },
        "peak_nm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Peak wavelength; null for the broadband 'vis' LED.",
          "title": "Peak Nm",
          "x-since": 1,
          "x-unit": "nm"
        },
        "pin": {
          "description": "GPIO number.",
          "minimum": 0,
          "title": "Pin",
          "type": "integer",
          "x-since": 1
        }
      },
      "required": [
        "id",
        "peak_nm",
        "pin"
      ],
      "title": "LedInfo",
      "type": "object"
    },
    "SensorsFound": {
      "description": "Sensors detected at boot. Sensors added later are optional.",
      "properties": {
        "ds18b20": {
          "description": "The DS18B20 was found on the bus.",
          "title": "Ds18B20",
          "type": "boolean",
          "x-since": 1
        },
        "dht22": {
          "description": "DHT22 responded.",
          "title": "Dht22",
          "type": "boolean",
          "x-since": 1
        },
        "tcs3448": {
          "description": "TCS3448 responded.",
          "title": "Tcs3448",
          "type": "boolean",
          "x-since": 1
        }
      },
      "required": [
        "ds18b20",
        "dht22",
        "tcs3448"
      ],
      "title": "SensorsFound",
      "type": "object"
    }
  },
  "description": "Configuration that is fixed for the lifetime of a boot. Sent once per boot, retained.\nGrouped per subsystem like tele; new subsystems are added as optional groups.",
  "properties": {
    "v": {
      "description": "Version of the schema. Increased only on breaking changes.",
      "maximum": 3,
      "minimum": 2,
      "title": "V",
      "type": "integer",
      "x-since": 1
    },
    "k": {
      "const": "info",
      "title": "K",
      "type": "string",
      "x-since": 1
    },
    "dev": {
      "description": "Hardware ID of the microcontroller",
      "pattern": "^[0-9a-f]{16}$",
      "title": "Dev",
      "type": "string",
      "x-since": 1
    },
    "fw": {
      "description": "Firmware version (optionally containing the git commit hash)",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$",
      "title": "Fw",
      "type": "string",
      "x-since": 1
    },
    "boot": {
      "description": "Boot counter, stored on flash memory of the microcontroller.",
      "minimum": 0,
      "title": "Boot",
      "type": "integer",
      "x-since": 1
    },
    "run": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "ID of the run (measurement series) this record belongs to; null outside a run. Unique per device: a counter stored on flash like boot, incremented and written before the run's start record, so a power loss can skip an ID but never reuse one. (dev, run) identifies a run.",
      "title": "Run",
      "x-since": 2
    },
    "seq": {
      "description": "Sequence number per record kind, for dedup (QoS 1, SD replay) and gap detection per kind. For data it counts per run and restarts at 0 with every run; for all other kinds it counts per boot. Unique key: (dev, run, seq) for data, (dev, boot, k, seq) for all other kinds.",
      "minimum": 0,
      "title": "Seq",
      "type": "integer",
      "x-since": 1
    },
    "up": {
      "description": "Monotonic seconds since boot, ms resolution. Time of measurement/event, not of sending. Use for intervals: ts may jump on re-sync.",
      "minimum": 0.0,
      "title": "Up",
      "type": "number",
      "x-since": 1,
      "x-unit": "s"
    },
    "ts": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Unix seconds UTC after NTP sync, captured together with up. null while unsynced; key is mandatory.",
      "title": "Ts",
      "x-since": 1,
      "x-unit": "s"
    },
    "sys": {
      "$ref": "#/$defs/InfoSys",
      "x-since": 1
    },
    "sensors": {
      "$ref": "#/$defs/SensorsFound",
      "description": "Sensors detected at boot. Firmware does not rescan, so this is not updated during the boot; data records show which sensors actually respond. Sensor configuration is in the per-sensor groups regardless of detection.",
      "x-since": 1
    },
    "ds18b20": {
      "$ref": "#/$defs/InfoDs18b20",
      "x-since": 1
    },
    "tcs3448": {
      "$ref": "#/$defs/InfoTcs3448",
      "x-since": 1
    },
    "leds": {
      "description": "Illumination LEDs fitted to the device.",
      "items": {
        "$ref": "#/$defs/LedInfo"
      },
      "title": "Leds",
      "type": "array",
      "x-since": 1
    },
    "profiles": {
      "$ref": "#/$defs/InfoProfiles",
      "x-since": 2
    },
    "pio": {
      "$ref": "#/$defs/InfoPio",
      "x-since": 1
    },
    "pwm": {
      "$ref": "#/$defs/InfoPwm",
      "x-since": 1
    },
    "sd": {
      "anyOf": [
        {
          "$ref": "#/$defs/InfoSd"
        },
        {
          "type": "null"
        }
      ],
      "description": "null if no SD card is mounted.",
      "x-since": 1
    }
  },
  "required": [
    "v",
    "k",
    "dev",
    "fw",
    "boot",
    "run",
    "seq",
    "up",
    "ts",
    "sys",
    "sensors",
    "ds18b20",
    "tcs3448",
    "leds",
    "profiles",
    "pio",
    "pwm",
    "sd"
  ],
  "title": "InfoRecord",
  "type": "object"
}
