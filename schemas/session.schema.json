{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 2,
  "description": "Creates a session: runs started together, with a description of the experiment.",
  "properties": {
    "v": {
      "description": "Version of the schema. Increased only on breaking changes.",
      "maximum": 2,
      "minimum": 2,
      "title": "V",
      "type": "integer",
      "x-since": 1
    },
    "k": {
      "const": "session",
      "title": "K",
      "type": "string",
      "x-since": 2
    },
    "id": {
      "description": "Session ID, generated by the CLI; referenced as session in cmd and run.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string",
      "x-since": 2
    },
    "title": {
      "description": "Short title.",
      "title": "Title",
      "type": "string",
      "x-since": 2
    },
    "desc": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Description of the experiment.",
      "title": "Desc",
      "x-since": 2
    },
    "setup": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Description of the physical setup.",
      "title": "Setup",
      "x-since": 2
    },
    "by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Person who ran the session.",
      "title": "By",
      "x-since": 2
    },
    "ts": {
      "description": "Creation time on the laptop, Unix seconds UTC.",
      "minimum": 0.0,
      "title": "Ts",
      "type": "number",
      "x-since": 2,
      "x-unit": "s"
    }
  },
  "required": [
    "v",
    "k",
    "id",
    "title",
    "desc",
    "setup",
    "by",
    "ts"
  ],
  "title": "SessionMessage",
  "type": "object"
}
