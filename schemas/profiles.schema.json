{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 2,
  "$defs": {
    "CaptureConfig": {
      "description": "Timing of one TCS3448 capture cycle.",
      "properties": {
        "sequence": {
          "description": "illumination values in capture order; exactly one dark, as in data m.tcs3448.",
          "items": {
            "enum": [
              "dark",
              "nir",
              "blue",
              "vis"
            ],
            "type": "string"
          },
          "title": "Sequence",
          "type": "array",
          "x-since": 2
        },
        "settle_ms": {
          "description": "LED settling time before integration starts.",
          "minimum": 0,
          "title": "Settle Ms",
          "type": "integer",
          "x-since": 2,
          "x-unit": "ms"
        },
        "on_ms": {
          "description": "LED on-time per capture.",
          "minimum": 0,
          "title": "On Ms",
          "type": "integer",
          "x-since": 2,
          "x-unit": "ms"
        }
      },
      "required": [
        "sequence",
        "settle_ms",
        "on_ms"
      ],
      "title": "CaptureConfig",
      "type": "object"
    },
    "RunConfig": {
      "description": "Measurement settings of a run, resolved from its profile. Also the value type of the\ndevice's profile file.",
      "properties": {
        "sample_interval_ms": {
          "description": "Interval between measurement cycles.",
          "exclusiveMinimum": 0,
          "title": "Sample Interval Ms",
          "type": "integer",
          "x-since": 2,
          "x-unit": "ms"
        },
        "capture": {
          "$ref": "#/$defs/CaptureConfig",
          "x-since": 2
        }
      },
      "required": [
        "sample_interval_ms",
        "capture"
      ],
      "title": "RunConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z0-9_]+$": {
      "$ref": "#/$defs/RunConfig"
    }
  },
  "type": "object"
}
